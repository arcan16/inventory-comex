# Copia este archivo como .env en esta misma carpeta (no se sube a git) y llena los valores.
# docker compose lo lee automaticamente al levantar los contenedores.
# Para correr la API fuera de Docker, define estas mismas variables en el sistema o en el IDE
# (ademas de URL_DB_INVENTORIES_COMEX, USER_DB_INVENTORIES_COMEX y JWT_EXPIRATION_TIME_INVENTORIES_COMEX).

# Contrasena de root de MySQL (la usan la base de datos y la API)
PASSWORD_DB_INVENTORIES_COMEX=

# Clave para firmar los tokens JWT (por ejemplo: openssl rand -base64 32)
JWT_SECRET_KEY_INVENTORIES_COMEX=

# Usuario administrador que se crea al iniciar si la tabla de usuarios esta vacia
ADMIN_USERNAME_INVENTORIES_COMEX=
ADMIN_PASSWORD_INVENTORIES_COMEX=
ADMIN_EMAIL_INVENTORIES_COMEX=
